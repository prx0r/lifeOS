        "product": "Honey + Pollination + Wax",
        "seasonality": "Active Mar-Oct, dormant Nov-Feb",
        "annualYield": "20-30kg honey per hive = 40-60kg from 2 hives",
        "whatYouMake": ["Honey (raw, comb, or extracted)", "Beeswax (candles, cosmetics)", "Pollination for your garden crops"],
        "note": "Bees pollinate your tomatoes, beans, squash, fruit trees. Without them, yields drop 30-50%."
      },
