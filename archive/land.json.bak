  "food": {
    "summary": "Food comes from animals AND plants together. Neither alone gives you a complete diet.",
    "yearRoundHonestAnswer": {
      "verdict": "YES, you can eat from your land year-round — but not everything every day. It's seasonal, rhythmic, and requires planning.",
      "gaps": [
        "Winter (Dec-Feb): Fresh vegetables limited to cold-hardy greens. Root storage helps but runs out by Feb. You'll eat more eggs, ghee, and stored grains.",
        "Carbohydrates: You can grow potatoes, rajma, madua, jhangora — but rice/wheat you'll likely still buy. Growing enough grain for one person on 1 acre is labor-intensive.",
        "Fruit: Trees take 3-5 years. First 2-3 years you buy fruit.",
        "Protein: Eggs + milk + goat cheese covers most. Occasional mutton if you breed goats."
      ],
      "whatYouCanProduce": {
        "daily": "Milk (6-7L average), eggs (6-12/day average), fresh greens, herbs, honey",
        "weekly": "Paneer, ghee, cheese, fresh vegetables, salads",
        "monthly": "Root vegetables from storage, dried herbs, pickles, preserved tomatoes",
        "seasonally": "Fruit (apple, pear, plum), turmeric, ginger, grains (rajma, madua)"
      },
      "whatYouStillBuy": [
        "Rice and wheat (unless you grow grain — possible but labor-intensive)",
        "Salt, oil, spices (cheap locally)",
        "Tea (unless you grow it — possible at altitude)",
        "Clothing",
        "Medical supplies",
        "Internet/phone",
        "Tools and equipment"
      ],
      "selfSufficiencyPercentage": "~70-80% of food from your land. ~20-30% purchased locally."
    },

    "risks": [
      {
        "risk": "Frost kills crops",
        "likelihood": "Medium — frost Nov-Feb is regular at your altitude",
        "mitigation": "Cold frames (₹2K-5K), plastic row covers, grow frost-hardy varieties in winter"
      },
      {
        "risk": "Monsoon waterlogging",
        "likelihood": "High — Jul-Sep heavy rain",
