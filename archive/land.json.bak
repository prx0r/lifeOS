      },
      {
        "risk": "Borewell runs dry",
        "likelihood": "Low — Kumaon has good groundwater, but possible in severe drought",
        "mitigation": "Rainwater harvesting (already in budget), river access as backup"
      },
      {
        "risk": "Pest/disease outbreak",
        "likelihood": "Medium — especially in monsoon (fungal)",
        "mitigation": "Organic neem spray, crop rotation, diverse planting, chickens eat pests"
      },
      {
        "risk": "Cow goes dry when you need milk most",
        "likelihood": "Certain — 2-3 months/year dry period",
        "mitigation": "Stagger goat breeding so at least 1-2 goats always milking. Store ghee."
      },
      {
        "risk": "Winter food gap (Dec-Feb)",
        "likelihood": "Certain — limited fresh vegetables",
        "mitigation": "Root cellar storage, preserved food, cold frames, winter greens (spinach, mustard)"
      },
      {
        "risk": "Wild animals raid crops",
        "likelihood": "Medium — monkeys, boar, deer common in Kumaon",
        "mitigation": "Fencing around garden, noise deterrents, guard dog helps"
      },
      {
        "risk": "Too much rain destroys harvest",
        "likelihood": "Low-Medium — monsoon can be intense",
        "mitigation": "Terracing, drainage, diverse crops so total loss unlikely"
      }
