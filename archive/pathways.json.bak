  "dependencyMatrix": {
    "description": "What blocks what. Money is the primary unlock. Hindi is the secondary. Legal is the hard gate.",
    "matrix": {
      "money→company": "Need ₹20–50K to register company",
      "company→visa": "Need company to apply for Employment Visa",
      "visa→estate": "Need visa to legally live on estate",
      "hindi→lease": "Need Hindi to negotiate with landowners",
      "hindi→farm": "Need Hindi to deal with vets, farmers, suppliers",
      "hindi→business": "Need Hindi to sell products, negotiate deals",
      "hindi→philosophy": "Need literary Hindi to publish Indian philosophy",
      "money→animals": "Need ₹2–4L for animals + shelter",
      "money→lab": "Need ₹3–8L for mushroom lab",
      "starlink→remote": "Need Starlink for reliable remote work",
      "bhui→visa": "BHU gives student visa, leads to Employment Visa pathway"
    },
    "criticalPath": "Money → Company → Visa → Estate → Animals → Products → Revenue"
  },

  "risks": [
    {
      "risk": "Not enough money saved by Sept 2029",
      "consequence": "Cannot register company, cannot get Employment Visa, must leave India",
      "mitigation": "Save aggressively now. Every dollar counts. Remote income is the key.",
      "severity": "CRITICAL"
    },
    {
      "risk": "Employment Visa denied",
      "consequence": "Cannot stay in India after BHU graduation",
      "mitigation": "Start company early, ensure salary structure meets ₹25L threshold, have backup plan (leave and reapply from outside)",
      "severity": "CRITICAL"
    },
    {
      "risk": "Hindi not good enough by BHU start",
      "consequence": "Struggle in classes, cannot negotiate leases, isolated",
      "mitigation": "Start NOW. Varanasi immersion will accelerate. Daily practice non-negotiable.",
      "severity": "HIGH"
    },
    {
      "risk": "Property doesn't work out (terrain, water, community)",
      "consequence": "Must find alternative location, delay estate setup",
      "mitigation": "Scout in person during BHU. Don't commit until you've visited.",
      "severity": "MEDIUM"
    },
    {
      "risk": "Remote income insufficient for Employment Visa salary",
      "consequence": "Company must generate ₹25L+/year OR you need external income",
      "mitigation": "Start building remote income NOW.叠加 multiple streams. Supplement sales can also count.",
      "severity": "HIGH"
    },
    {
      "risk": "BHU masters doesn't lead anywhere useful",
      "consequence": "2 years wasted on degree that doesn't help the vision",
      "mitigation": "BHU gives: student visa (2 years), Hindi immersion, academic network, philosophy foundation, time to plan. The degree itself is secondary to these.",
      "severity": "LOW"
    }
  ],

