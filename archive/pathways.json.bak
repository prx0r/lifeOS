{
  "meta": {
    "version": "9.0.0",
    "lastUpdated": "2026-09-04",
    "model": "Pathways, Blockages, Doorways — dependencies that unlock possibilities"
  },

  "variables": {
    "money": {
      "type": "primary unlock",
      "why": "Without money, nothing is possible. With money, everything becomes negotiable.",
      "tiers": {
        "tier1_0_5k": {"label": "₹0–5K ($0–60)", "unlocks": "Nothing permanent. Research phase. Learn Hindi. Plan."},
        "tier2_5k_20k": {"label": "₹5K–20K ($60–240)", "unlocks": "Scouting trip. Visit Dehradun/Almora. See properties in person. Meet locals."},
        "tier3_20k_50k": {"label": "₹20K–50K ($240–600)", "unlocks": "Register Indian company (₹15–50K). Start Employment Visa process."},
        "tier4_50k_150k": {"label": "₹50K–150K ($600–$1,800)", "unlocks": "Company setup complete. Employment Visa approved. Lease deposit on land. Move to India."},
        "tier5_150k_500k": {"label": "₹150K–500K ($1,800–$6,000)", "unlocks": "Lease secured. Temporary shelter built. Animals purchased. Farm running."},
        "tier6_500k_1500k": {"label": "₹500K–1.5M ($6,000–$18,000)", "unlocks": "Full estate operational. Mushroom lab. Supplement production. Publishing setup."},
        "tier7_1500k_plus": {"label": "₹1.5M+ ($18,000+)", "unlocks": "Permanent build. Full brand. Export capability. The dream realised."}
      }
    },
    "hindi": {
      "type": "progressive unlock",
      "why": "You can survive without Hindi. You cannot thrive without it. Every interaction — buying animals, dealing with vets, negotiating leases, running the company — is easier in Hindi.",
      "levels": {
        "level1_basics": {"label": "Basic survival Hindi", "unlocks": "Buy things, ask directions, basic negotiation. Tourist visa works."},
        "level2_conversational": {"label": "Conversational Hindi", "unlocks": "Negotiate leases, deal with vets, talk to farmers, run daily farm operations. Company registration easier."},
        "level3_fluent": {"label": "Fluent Hindi", "unlocks": "Legal discussions, business negotiations, teaching at BHU (if needed), deep community integration. Full independence."},
        "level4_literary": {"label": "Literary/Academic Hindi", "unlocks": "Publish Indian philosophy in Hindi. Teach at BHU. Full academic integration. This is where the philosophy dream lives."}
      },
      "currentLevel": "Unknown — starting from December 2026 in Varanasi (Hindi heartland)",
      "pathway": "Varanasi immersion → BHU environment → 2 years of daily Hindi → conversational by graduation"
    },
    "time": {
      "type": "fixed constraint",
      "why": "You can't speed up time, but you can use it strategically. Parallel tracks matter.",
      "milestones": {
        "now": "Cambodia, tourist visa. Research phase.",
        "dec2026": "Arrive Varanasi. Start Hindi immersion. Scout Dehradun/Almora during breaks.",
        "sept2027": "BHU masters begins. Student visa. 2 years of study + Hindi + farming research.",
        "sept2029": "BHU graduation. Student visa expires. Must have company registered + Employment Visa ready.",
        "2029_2034": "5-year experiment on leased estate. Full ecosystem running. Company growing.",
        "2034_plus": "Decision: permanent build or new location."
      }
    },
    "legal": {
      "type": "hard gate",
      "why": "Some things are illegal, not just difficult. Visa and company status are non-negotiable.",
      "gates": {
        "tourist_visa": "180 days/year max. No work. No study. Must exit every 6 months.",
        "student_visa": "BHU enrollment. No work. Duration = course length. FRRO registration required.",
        "company_registration": "₹15–50K. 10-15 days. 100% foreign ownership allowed. Enables Employment Visa.",
        "employment_visa": "Requires company paying you ₹25L+/year. Employer-specific. Enables legal residence + work.",
        "frro_registration": "Required within 14 days of arrival on long-term visa. Non-negotiable.",
        "agricultural_land": "CANNOT BUY. Must lease. Structures are temporary unless you own the land.",
        "cannabis": "Industrial hemp legal with license (Uttarakhand). Recreational cannabis illegal.",
        "psilocybin": "Gray area — Kerala ruling narrow. Research only.",
        "dmt": "Fully illegal. No exceptions."
      }
    }
  },

  "pathways": {
    "mainPath": {
      "name": "The Estate Path",
      "description": "Lease land → build estate → company processes products → Employment Visa → permanent life",
      "blockages": [
        {
          "block": "Money for company registration",
          "threshold": "₹20K–50K ($240–600)",
          "whenNeeded": "Before Sept 2029 (BHU graduation)",
          "consequence": "Cannot get Employment Visa without company",
          "priority": "CRITICAL"
        },
        {
          "block": "Money for visa fees + travel",
          "threshold": "₹30K–50K ($360–600)",
          "whenNeeded": "Sept 2029",
          "consequence": "Cannot stay in India after graduation",
          "priority": "CRITICAL"
        },
        {
          "block": "Hindi for BHU + daily life",
          "threshold": "Conversational by Sept 2027",
          "whenNeeded": "BHU enrollment + Varanasi life",
          "consequence": "Struggle in classes, can't negotiate anything, isolated",
          "priority": "HIGH"
        },
        {
          "block": "Money for land lease deposit",
          "threshold": "₹1–3L ($1,200–3,600)",
          "whenNeeded": "During or after BHU",
          "consequence": "Cannot secure the estate",
          "priority": "HIGH"
        },
        {
          "block": "Money for animals + shelter",
          "threshold": "₹2–4L ($2,400–4,800)",
          "whenNeeded": "After lease secured",
          "consequence": "No farm running",
          "priority": "HIGH"
        },
        {
          "block": "Remote income",
          "threshold": "₹25L+/year for Employment Visa ($30K+)",
          "whenNeeded": "Sept 2029",
          "consequence": "Company must generate this or you need external income",
          "priority": "CRITICAL"
        }
      ],
      "doorways": [
        {
          "door": "BHU enrollment",
          "unlocks": "Student visa (2 years), Hindi immersion, academic network, philosophy foundation",
          "when": "Sept 2027"
        },
        {
          "door": "Company registration",
          "unlocks": "Employment Visa eligibility, legal business operations, bank account",
          "when": "During BHU (Year 1-2)"
        },
        {
          "door": "Land lease secured",
          "unlocks": "Can build temporary structures, keep animals, start farming",
          "when": "During BHU or after"
        },
        {
          "door": "Employment Visa approved",
          "unlocks": "Legal residence, can live on estate full-time, FRRO registration",
          "when": "Sept 2029 (graduation)"
        },
        {
          "door": "First product sold",
          "unlocks": "Revenue stream, proves business model, funds expansion",
          "when": "Year 1-2 of estate operation"
        },
        {
          "door": "Starlink available",
          "unlocks": "Reliable high-speed internet for remote work from estate",
          "when": "Late 2026 / Early 2027"
        }
      ]
    }
  },

