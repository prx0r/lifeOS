  "ecosystem": {
    "name": "The Core Seven",
    "description": "One cow, three sheep, three goats, two dogs, twenty-five chickens, two bee hives. Every animal has a role. Nothing is decorative.",
    "howItWorks": {
      "grazing": "Cow eats grass. Sheep eat broadleaf weeds. Goats eat brush and woody plants. They clean the pasture together — no herbicide needed.",
      "parasites": "Cow parasites can't survive in sheep. Sheep parasites can't survive in cow. Grazing together breaks parasite cycles naturally.",
      "protection": "Bakharwal lives with the flock — protects chickens, sheep, goats from foxes, stray dogs, leopards. GSD is your thinking companion.",
      "pestControl": "Chickens eat ticks, insects, snakes. Bees pollinate your crops. Goats eat invasive brush.",
      "closedLoop": "Cow dung → compost → garden → kitchen scraps → chickens → more compost. Cow milk → drink. Sheep wool → spin. Goat milk → cheese. Bee honey → medicine."
    },
    "spaceOn5Acres": {
      "used": "1.5-2 acres",
      "remaining": "3-3.5 acres for house, kitchen garden, mushroom lab, crops, forest, trails"
    }
  },

